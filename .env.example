# ==============================================
# Environment Variables Template (TrangSM)
# Copy this file to .env and fill in the values
# ==============================================

# --- General ---
COMPOSE_PROJECT_NAME=trang-sm
ENVIRONMENT=development

# --- Database ---
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=root

# --- Infrastructure ---
REDIS_PORT=6379
KAFKA_PORT=9092
KAFKA_UI_PORT=8080

# --- Service Ports (External) ---
LOCATION_SERVICE_PORT=8087
USER_SERVICE_PORT=8082
DRIVER_SERVICE_PORT=8083
VEHICLE_SERVICE_PORT=8084
NOTIFICATION_SERVICE_PORT=8088

# --- API Gateway & Frontend (Planned) ---
GATEWAY_PORT=8080
FRONTEND_PORT=3000
